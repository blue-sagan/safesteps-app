# ============================================================================
# SafeSteps server configuration — copy to .env and fill in real values.
# .env is git-ignored. Only `SUPABASE_PUBLISHABLE_KEY` is ever sent to browsers.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# Port the HTTP server listens on (the platform proxies this).
PORT=8080
# Public origin users reach the app on. Used for CORS + cookie decisions.
PUBLIC_ORIGIN=https://safesteps.example.org

# --- Supabase --------------------------------------------------------------
# Project URL is public information.
SUPABASE_URL=https://mlgwfzcuumdjgywybujf.supabase.co
# Publishable (anon) key. PUBLIC BY DESIGN: it grants only what RLS allows.
# This is the ONLY Supabase key that may appear in browser code or config.
SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (NEVER exposed to the client) ---------------------
# service_role key: bypasses RLS. Used solely for server-side verification
# challenge bookkeeping. Rotate immediately if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=
# Note: server-side keys are also mirrored into Supabase project secrets
# (see supabase/functions) for the Edge Function path.

# HMAC pepper mixed into verification-code / rate-limit fingerprints.
# Generate with:  openssl rand -hex 32
VERIFICATION_PEPPER=

# 32-byte base64 key for AES-256-GCM encryption of anything the server itself
# must hold in readable form (e.g. the outbound mail spool body in-flight).
# Generate with:  openssl rand -base64 32
SERVER_DATA_KEY=

# --- Transactional email (server-side only) --------------------------------
# Transport order: SMTP -> EmailJS -> Supabase Auth's mailer -> encrypted spool.
# Leave both providers blank to keep messages in the private outbound_mail queue.

# 1) SMTP (delivers to any mailbox, no third-party rate limit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SafeSteps Kenya <no-reply@safesteps.example.org>

# 2) EmailJS REST API. These are SERVER-ONLY: the browser never receives them,
#    so there is no key in index.html and no key in localStorage. Use the
#    private key if the account provides one (it is sent as `accessToken`);
#    otherwise the public key authenticates the call on its own.
#    Dashboard: https://dashboard.emailjs.com/admin  ->  Account / Email Services
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional: a dedicated template for verification codes. When set, the code
# arrives as its own variable ({{verification_code}}) instead of in the body.
EMAILJS_TEMPLATE_VERIFICATION=
# Optional override (only useful for a proxy/self-hosted relay).
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send

# --- Supabase Send Email Hook (preferred) ----------------------------------
# Enable Authentication -> Hooks -> Send Email in the Supabase dashboard, type
# HTTP, URL https://<public-origin>/api/hooks/send-email, secret = this value.
# GoTrue then mails through this server, which relays via SMTP/EmailJS. The code
# becomes GoTrue's own, so /verify returns a session and NO service-role key is
# needed. Format: v1,whsec_<base64>. Generate one with:
#   printf 'v1,whsec_%s' "$(openssl rand -base64 32 | tr -d '\n')"
SEND_EMAIL_HOOK_SECRET=
